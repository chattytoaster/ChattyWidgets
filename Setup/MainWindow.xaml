<Window x:Class="ChattyWidgets.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка ChattyWidgets"
        Width="680" Height="620"
        MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="../app.ico"
        ShowInTaskbar="True">

    <Border Background="#F40B0E18"
            BorderBrush="#354060"
            BorderThickness="1.2"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.75" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/> <!-- Custom Titlebar -->
                <RowDefinition Height="*"/>  <!-- Wizard Body -->
            </Grid.RowDefinitions>

            <!-- Custom Titlebar -->
            <Grid Grid.Row="0" Background="#12FFFFFF" MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="../app.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtAppTitle" Text="ChattyWidgets Setup" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <!-- Language Selector -->
                    <Border Background="#161B2E" BorderBrush="#2F3B5C" BorderThickness="1" CornerRadius="12" Padding="2" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnLangRu" Content="🇷🇺 RU" Width="52" Height="24" FontSize="11" FontWeight="SemiBold"
                                    Click="OnLangRuClick" Style="{StaticResource LangBtnStyle}"/>
                            <Button x:Name="BtnLangEn" Content="🇬🇧 EN" Width="52" Height="24" FontSize="11" FontWeight="SemiBold"
                                    Click="OnLangEnClick" Style="{StaticResource LangBtnStyle}"/>
                        </StackPanel>
                    </Border>

                    <Button Content="—" Width="36" Height="30" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                            FontSize="13" Cursor="Hand" Click="OnMinimizeClick">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#20FFFFFF"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="✕" Width="36" Height="30" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                            FontSize="13" Cursor="Hand" Click="OnCloseClick">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#35EF4444"/>
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- WIZARD STEP 1: OPTIONS -->
            <Grid Grid.Row="1" x:Name="ViewOptions" Margin="28,16,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header branding -->
                    <RowDefinition Height="Auto"/> <!-- Folder Picker -->
                    <RowDefinition Height="*"/>    <!-- Options Cards -->
                    <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
                </Grid.RowDefinitions>

                <!-- Header Branding -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="60" Height="60" CornerRadius="14" Background="#1E243A" BorderBrush="#3B4870" BorderThickness="1" Margin="0,0,16,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" Color="#6366F1" Opacity="0.4" ShadowDepth="4"/>
                        </Border.Effect>
                        <Image Source="../app.png" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtHeaderTitle" Text="Установка ChattyWidgets" FontSize="21" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <Border Background="#2A3350" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtVersionBadge" Text="v1.0.2" FontSize="11" FontWeight="Bold" Foreground="#818CF8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtHeaderSubtitle" Text="Платформа ультра-легковесных нативных виджетов для рабочего стола Windows" FontSize="12.5" Foreground="#94A3B8" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Target Directory Picker -->
                <Border Grid.Row="1" Background="#101422" BorderBrush="#26314A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TxtFolderLabel" Grid.Row="0" Text="📁 Папка для установки:" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="InputTargetDir" Background="#161B2E" Foreground="#F8FAFC" BorderBrush="#333F60"
                                     BorderThickness="1" Padding="10,7" FontSize="12.5" VerticalAlignment="Center"/>
                            <Button x:Name="BtnBrowseFolder" Grid.Column="1" Content="Обзор..." Style="{StaticResource SetupSecondaryBtn}" Margin="8,0,0,0" Click="OnBrowseFolderClick"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Options Checkboxes Card -->
                <Border Grid.Row="2" Background="#101422" BorderBrush="#26314A" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="TxtOptionsLabel" Text="⚙️ Параметры и интеграции:" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>

                            <CheckBox x:Name="CheckDesktopShortcut" IsChecked="True" Content="Создать ярлык на рабочем столе Windows"/>
                            <CheckBox x:Name="CheckStartMenuShortcut" IsChecked="True" Content="Создать ярлык в меню «Пуск»"/>
                            <CheckBox x:Name="CheckStartWithWindows" IsChecked="True" Content="Запускать ChattyWidgets автоматически при старте Windows"/>
                            <CheckBox x:Name="CheckRegisterAssoc" IsChecked="True" Content="Ассоциировать пакеты виджетов (.chw) и пресетов (.chwp)"/>

                            <!-- Agent Skill Checkbox (User Requirement) -->
                            <Border Background="#161B30" BorderBrush="#3A4670" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,6,0,6">
                                <StackPanel>
                                    <CheckBox x:Name="CheckInstallSkill" IsChecked="True" FontWeight="SemiBold" Foreground="#F8FAFC"
                                              Content="🤖 Установить скилл для AI-ассистентов (/chw в ~/.agents/skills/chw)"/>
                                    <TextBlock x:Name="TxtSkillDesc" Text="Позволяет Antigravity, Claude Code, Cursor и Codex автономно разрабатывать виджеты по команде /chw"
                                               FontSize="11" Foreground="#818CF8" Margin="30,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Open Website Checkbox (User Requirement) -->
                            <Border Background="#161B30" BorderBrush="#3A4670" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <CheckBox x:Name="CheckOpenWebsite" IsChecked="True" FontWeight="SemiBold" Foreground="#F8FAFC"
                                              Content="🌐 Открыть официальный сайт chattyapps.dev после завершения"/>
                                    <TextBlock x:Name="TxtWebsiteDesc" Text="Каталог виджетов, документация, ссылки на Telegram-канал и экосистема ChattyApps"
                                               FontSize="11" Foreground="#38BDF8" Margin="30,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <CheckBox x:Name="CheckLaunchApp" IsChecked="True" Content="Запустить ChattyWidgets сразу после установки"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Bottom Action Buttons -->
                <DockPanel Grid.Row="3" LastChildFill="False">
                    <Button x:Name="BtnCancel" DockPanel.Dock="Left" Content="Отмена" Style="{StaticResource SetupSecondaryBtn}" Width="100" Click="OnCloseClick"/>
                    <Button DockPanel.Dock="Right" x:Name="BtnStartInstall" Content="✨ Установить" Style="{StaticResource SetupPrimaryBtn}" Width="160" Click="OnStartInstallClick"/>
                </DockPanel>
            </Grid>

            <!-- WIZARD STEP 2: INSTALLATION PROGRESS -->
            <Grid Grid.Row="1" x:Name="ViewProgress" Visibility="Collapsed" Margin="36,40,36,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,24">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#1E2338" BorderBrush="#6366F1" BorderThickness="2" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25" Color="#6366F1" Opacity="0.5"/>
                        </Border.Effect>
                        <TextBlock Text="⚡" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtProgressTitle" Text="Установка компонентов ChattyWidgets" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtProgressSubtitle" Text="Пожалуйста, подождите, выполняется распаковка и настройка системы..." FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#101422" BorderBrush="#26314A" BorderThickness="1" CornerRadius="12" Padding="20" VerticalAlignment="Center">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="TxtCurrentAction" Text="Подготовка файлов..." FontSize="13" Foreground="#CBD5E1" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="TxtProgressPercent" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#818CF8" DockPanel.Dock="Right"/>
                        </DockPanel>

                        <!-- Progress Bar -->
                        <Border Height="8" CornerRadius="4" Background="#161B2E" BorderBrush="#2A3554" BorderThickness="1">
                            <ProgressBar x:Name="ProgressBarSetup" Height="8" Minimum="0" Maximum="100" Value="0"
                                         Foreground="#6366F1" Background="Transparent" BorderThickness="0"/>
                        </Border>

                        <TextBlock x:Name="TxtProgressFooter" Text="Интеграция с оболочкой Windows, регистрация протоколов и настройка скилла..." FontSize="11" Foreground="#64748B" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- WIZARD STEP 3: FINISHED -->
            <Grid Grid.Row="1" x:Name="ViewFinished" Visibility="Collapsed" Margin="36,36,36,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,18">
                    <Border x:Name="BorderFinishedIcon" Width="68" Height="68" CornerRadius="34" Background="#064E3B" BorderBrush="#10B981" BorderThickness="2" Margin="0,0,0,14">
                        <Border.Effect>
                            <DropShadowEffect x:Name="ShadowFinishedIcon" BlurRadius="30" Color="#10B981" Opacity="0.55"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtFinishedIcon" Text="✓" FontSize="36" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                    </Border>
                    <TextBlock x:Name="TxtFinishedTitle" Text="Установка успешно завершена!" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtFinishedSubtitle" Text="ChattyWidgets и все выбранные компоненты настроены и готовы к работе." FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#101422" BorderBrush="#26314A" BorderThickness="1" CornerRadius="12" Padding="20,16" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="TxtFinishResultsHeader" Text="Результаты установки:" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="✓" Foreground="#34D399" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtFinishPath" Text="Программа установлена в целевую папку" FontSize="12.5" Foreground="#CBD5E1"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="✓" Foreground="#34D399" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtFinishAssoc" Text="Ассоциации пакетов .chw и .chwp зарегистрированы в реестре" FontSize="12.5" Foreground="#CBD5E1"/>
                        </StackPanel>
                        <StackPanel x:Name="ItemFinishSkill" Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="✓" Foreground="#34D399" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtFinishSkillText" Text="Скилл /chw активирован в ~/.agents/skills/chw для всех AI-ассистентов" FontSize="12.5" Foreground="#CBD5E1"/>
                        </StackPanel>
                        <StackPanel x:Name="ItemFinishWebsite" Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="✓" Foreground="#34D399" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtFinishWebsiteText" Text="Будет открыт официальный сайт https://chattyapps.dev" FontSize="12.5" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Bottom Button -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="BtnFinish" Content="🚀 Завершить и запустить" Style="{StaticResource SetupPrimaryBtn}" Width="210" Height="44" Click="OnFinishClick"/>
                </StackPanel>
            </Grid>

            <!-- UNINSTALL STEP 1: CONFIRM -->
            <Grid Grid.Row="1" x:Name="ViewUninstallConfirm" Visibility="Collapsed" Margin="28,20,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header branding -->
                    <RowDefinition Height="Auto"/> <!-- Target dir info -->
                    <RowDefinition Height="*"/>    <!-- Options checkboxes -->
                    <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
                </Grid.RowDefinitions>

                <!-- Header Branding -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="60" Height="60" CornerRadius="14" Background="#2A141A" BorderBrush="#EF4444" BorderThickness="1.5" Margin="0,0,16,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" Color="#EF4444" Opacity="0.4" ShadowDepth="4"/>
                        </Border.Effect>
                        <TextBlock Text="🗑️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtUninstallTitle" Text="Удаление ChattyWidgets" FontSize="21" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock x:Name="TxtUninstallSubtitle" Text="Вы действительно хотите удалить ChattyWidgets с вашего компьютера?" FontSize="12.5" Foreground="#94A3B8" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- Target Directory Info Card -->
                <Border Grid.Row="1" Background="#101422" BorderBrush="#26314A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="TxtUninstallPathLabel" Text="📁 Программа будет удалена из:" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtUninstallPath" Text="C:\Users\...\Programs\ChattyWidgets" FontSize="12" Foreground="#818CF8" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Options Checkboxes Card -->
                <Border Grid.Row="2" Background="#101422" BorderBrush="#26314A" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="TxtUninstallOptionsLabel" Text="Параметры очистки:" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,10"/>
                        <CheckBox x:Name="CheckUninstallRemoveSkill" IsChecked="True" Content="Удалить скилл /chw для AI-ассистентов (~/.agents/skills/chw)" Margin="0,0,0,8"/>
                        <CheckBox x:Name="CheckUninstallRemoveUserData" IsChecked="False" Content="Удалить пользовательские виджеты и настройки (%LOCALAPPDATA%\ChattyWidgets)"/>
                        <TextBlock x:Name="TxtUninstallDataWarn" Text="⚠️ Внимание: если вы отметите эту опцию, все ваши скачанные виджеты и персональные настройки будут удалены." FontSize="11" Foreground="#F59E0B" Margin="30,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Bottom Buttons -->
                <DockPanel Grid.Row="3" LastChildFill="False">
                    <Button x:Name="BtnUninstallCancel" DockPanel.Dock="Left" Content="Отмена" Style="{StaticResource SetupSecondaryBtn}" Width="100" Click="OnCloseClick"/>
                    <Button x:Name="BtnStartUninstall" DockPanel.Dock="Right" Content="🗑️ Удалить" Style="{StaticResource SetupDangerBtn}" Width="140" Click="OnStartUninstallClick"/>
                </DockPanel>
            </Grid>

            <!-- UNINSTALL STEP 2: FINISHED -->
            <Grid Grid.Row="1" x:Name="ViewUninstallFinished" Visibility="Collapsed" Margin="36,40,36,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,20,0,24">
                    <Border Width="68" Height="68" CornerRadius="34" Background="#1E2338" BorderBrush="#818CF8" BorderThickness="2" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25" Color="#6366F1" Opacity="0.5"/>
                        </Border.Effect>
                        <TextBlock Text="✓" FontSize="36" FontWeight="Bold" Foreground="#818CF8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                    </Border>
                    <TextBlock x:Name="TxtUninstallDoneTitle" Text="ChattyWidgets успешно удален" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtUninstallDoneSubtitle" Text="Все компоненты приложения, ярлыки и ассоциации были удалены с компьютера." FontSize="13" Foreground="#94A3B8" Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#101422" BorderBrush="#26314A" BorderThickness="1" CornerRadius="12" Padding="20,16" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="TxtUninstallDoneSummary" Text="Результаты удаления:" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtUninstallDoneItem1" Text="✓ Исполняемые файлы программы удалены" FontSize="12" Foreground="#CBD5E1" Margin="0,2"/>
                        <TextBlock x:Name="TxtUninstallDoneItem2" Text="✓ Ярлыки на Рабочем столе и в Пуске удалены" FontSize="12" Foreground="#CBD5E1" Margin="0,2"/>
                        <TextBlock x:Name="TxtUninstallDoneItem3" Text="✓ Записи реестра и ассоциации файлов очищены" FontSize="12" Foreground="#CBD5E1" Margin="0,2"/>
                    </StackPanel>
                </Border>

                <!-- Bottom Button -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="BtnUninstallFinish" Content="Закрыть" Style="{StaticResource SetupPrimaryBtn}" Width="140" Height="42" Click="OnUninstallFinishClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
