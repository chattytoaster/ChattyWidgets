<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <AssemblyName>ChattyWidgetsSetup</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\app.ico" Link="app.ico" />
    <Resource Include="..\app.png" Link="app.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.agents\skills\chw\**\*.*" Link=".agents\skills\chw\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.zip" Condition="Exists('app.zip')" />
  </ItemGroup>

</Project>
