<Window x:Class="ChattyWidgets.UI.GaugesConstructorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конструктор формата датчиков"
        Width="460" Height="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Border Background="#F0111522"
            BorderBrush="#30FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Titlebar -->
                <RowDefinition Height="Auto"/> <!-- Description -->
                <RowDefinition Height="*"/>    <!-- Items list -->
                <RowDefinition Height="Auto"/> <!-- Footer buttons -->
            </Grid.RowDefinitions>

            <!-- Custom Titlebar -->
            <Grid Grid.Row="0" Background="#18FFFFFF" Height="42" MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="🎨 " FontSize="14"/>
                    <TextBlock Text="Конструктор формата виджета" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC"/>
                </StackPanel>
                <Button Content="✕" Width="36" Height="30" HorizontalAlignment="Right" Margin="0,0,6,0"
                        Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                        FontSize="14" Cursor="Hand" Click="OnCloseClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#30EF4444"/>
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Description & Layout -->
            <StackPanel Grid.Row="1" Margin="18,14,18,6">
                <TextBlock Text="Настройте элементы, их порядок и вид отображения:" FontSize="12" Foreground="#94A3B8"/>
                <TextBlock Text="Вы можете перемещать метрики кнопками ▲ и ▼, включать GPU и выбирать между полоской и круговой диаграммой." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,8"/>
                <DockPanel Margin="0,2,0,2">
                    <TextBlock Text="Круговые диаграммы:" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <RadioButton x:Name="RbCols2" Content="2 в ряд (Сетка)" IsChecked="True" Foreground="#CBD5E1" FontSize="11" Margin="0,0,12,0" Cursor="Hand" Checked="OnCols2Checked"/>
                        <RadioButton x:Name="RbCols1" Content="1 в ряд (Список)" Foreground="#CBD5E1" FontSize="11" Cursor="Hand" Checked="OnCols1Checked"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <!-- Items List Host -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="18,10,18,10">
                <StackPanel x:Name="ItemsPanel">
                    <!-- Populated dynamically in code-behind -->
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="3" Background="#10FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0" Padding="18,12">
                <DockPanel>
                    <Button Content="↺ По умолчанию" DockPanel.Dock="Left" Click="OnResetDefaultsClick"
                            Background="#18FFFFFF" Foreground="#CBD5E1" BorderThickness="0"
                            Padding="12,6" FontSize="11" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <Button Content="Отмена" Click="OnCloseClick"
                                Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                Padding="14,6" FontSize="12" Cursor="Hand" Margin="0,0,8,0"/>
                        <Button Content="Применить" Click="OnApplyClick"
                                Background="#3B82F6" Foreground="#FFFFFF" BorderThickness="0"
                                FontWeight="SemiBold" Padding="18,6" FontSize="12" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
