<Window x:Class="ChattyWidgets.UI.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        Icon="/app.ico"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    
    <Window.ContextMenu>
        <ContextMenu x:Name="WidgetContextMenu">
            <MenuItem x:Name="MenuHeader" Header="ChattyWidget" IsEnabled="False" FontWeight="Bold"/>
            <Separator/>
            <MenuItem Header="📋 Скопировать виджет (Создать копию)" Click="OnDuplicateWidgetClick"/>
            <MenuItem Header="🗑 Удалить этот виджет" Click="OnDeleteInstanceClick" Foreground="#EF4444"/>
            <Separator/>
            <MenuItem Header="Слой отображения">
                <MenuItem x:Name="MenuLayerDesktop" Header="На рабочем столе (под всеми окнами)" Click="OnLayerDesktopClick"/>
                <MenuItem x:Name="MenuLayerNormal" Header="Плавающее окно" Click="OnLayerNormalClick"/>
                <MenuItem x:Name="MenuLayerTop" Header="Поверх всех окон" Click="OnLayerTopClick"/>
            </MenuItem>
            <MenuItem x:Name="MenuLockPosition" Header="Зафиксировать позицию" IsCheckable="True" Click="OnLockPositionClick"/>
            <MenuItem x:Name="MenuClickThrough" Header="Клик насквозь (Click-through)" IsCheckable="True" Click="OnClickThroughClick"/>
            <MenuItem x:Name="MenuAutoHideDot" Header="Спрятать точку управления" IsCheckable="True" Click="OnAutoHideDotClick"/>
            <MenuItem Header="Изменить размер">
                <MenuItem Header="75% (Компактный)" Click="OnResize75Click"/>
                <MenuItem Header="100% (Обычный)" Click="OnResize100Click"/>
                <MenuItem Header="125% (Увеличенный)" Click="OnResize125Click"/>
                <MenuItem Header="150% (Большой)" Click="OnResize150Click"/>
                <Separator/>
                <MenuItem x:Name="MenuFreeResizeToggle" Header="Тянуть за края (Свободный размер)" IsCheckable="True" Click="OnToggleFreeResizeClick"/>
            </MenuItem>
            <MenuItem Header="Прозрачность фона">
                <MenuItem Header="100% (Непрозрачный фон)" Click="OnOpacity100Click"/>
                <MenuItem Header="75% фона" Click="OnOpacity85Click"/>
                <MenuItem Header="50% фона" Click="OnOpacity70Click"/>
                <MenuItem Header="25% фона (Стекло)" Click="OnOpacity50Click"/>
            </MenuItem>
            <MenuItem x:Name="MenuMonitors" Header="Переместить на монитор..."/>
            <Separator x:Name="MenuCustomSeparator" Visibility="Collapsed"/>
            <MenuItem x:Name="MenuCustomSettings" Header="Настройки виджета" Visibility="Collapsed"/>
            <Separator/>
            <MenuItem Header="⟳ Перезагрузить виджет" Click="OnReloadWidgetClick"/>
            <MenuItem x:Name="MenuDevTools" Header="🛠 Открыть DevTools (F12)" Click="OnOpenDevToolsClick"/>
            <MenuItem Header="Открыть папку виджета" Click="OnOpenFolderClick"/>
            <MenuItem Header="Открыть Хаб ChattyWidgets" Click="OnOpenHubClick"/>
            <Separator/>
            <MenuItem Header="Скрыть виджет" Click="OnCloseWidgetClick" Foreground="#EF4444"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="MainRoot" Background="Transparent" MouseRightButtonUp="OnWindowRightButtonUp">
        <!-- Content placeholder for either Web or Native -->
        <ContentControl x:Name="WidgetContentHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

        <!-- Loading indicator -->
        <Border x:Name="LoadingIndicator" Background="#E0121622" CornerRadius="16" BorderBrush="#30FFFFFF" BorderThickness="1"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="TxtLoadingTitle" Text="✦ Загрузка виджета..." Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Anchor container and dot for click-through control and moving (always blue, neatly inside widget) -->
        <Grid x:Name="AnchorContainer" Width="36" Height="36"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Background="Transparent" Cursor="Hand"
              MouseRightButtonUp="OnAnchorDotRightClick"
              MouseLeftButtonDown="OnAnchorDotLeftDown"
              MouseEnter="OnAnchorContainerMouseEnter"
              MouseLeave="OnAnchorContainerMouseLeave">
            <Border x:Name="AnchorDot" Width="12" Height="12" Margin="0,12,12,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="#3B82F6" CornerRadius="6"
                    ToolTip="Точка управления ChattyWidgets (ПКМ — меню, ЛКМ — переместить)">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#60A5FA" Opacity="0.9"/>
                </Border.Effect>
                <!-- Inner white dot -->
                <Ellipse Width="4" Height="4" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</Window>
