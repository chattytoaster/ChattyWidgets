<Window x:Class="ChattyWidgets.UI.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Topmost="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    
    <Window.ContextMenu>
        <ContextMenu x:Name="WidgetContextMenu">
            <MenuItem x:Name="MenuHeader" Header="ChattyWidget" IsEnabled="False" FontWeight="Bold"/>
            <Separator/>
            <MenuItem Header="Слой отображения">
                <MenuItem x:Name="MenuLayerDesktop" Header="На рабочем столе (под всеми окнами)" Click="OnLayerDesktopClick"/>
                <MenuItem x:Name="MenuLayerNormal" Header="Плавающее окно" Click="OnLayerNormalClick"/>
                <MenuItem x:Name="MenuLayerTop" Header="Поверх всех окон" Click="OnLayerTopClick"/>
            </MenuItem>
            <MenuItem x:Name="MenuClickThrough" Header="Клик насквозь (Click-through)" Click="OnClickThroughClick"/>
            <MenuItem Header="Непрозрачность">
                <MenuItem Header="100%" Click="OnOpacity100Click"/>
                <MenuItem Header="85%" Click="OnOpacity85Click"/>
                <MenuItem Header="70%" Click="OnOpacity70Click"/>
                <MenuItem Header="50%" Click="OnOpacity50Click"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Открыть папку виджета" Click="OnOpenFolderClick"/>
            <MenuItem Header="Открыть Хаб ChattyWidgets" Click="OnOpenHubClick"/>
            <Separator/>
            <MenuItem Header="Скрыть виджет" Click="OnCloseWidgetClick" Foreground="#EF4444"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="MainRoot" Background="Transparent">
        <!-- Content placeholder for either Web or Native -->
        <ContentControl x:Name="WidgetContentHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>
