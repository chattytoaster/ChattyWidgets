<Window x:Class="ChattyWidgets.UI.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop">
    
    <Window.ContextMenu>
        <ContextMenu x:Name="WidgetContextMenu">
            <MenuItem x:Name="MenuHeader" Header="ChattyWidget" IsEnabled="False" FontWeight="Bold"/>
            <Separator/>
            <MenuItem x:Name="MenuWidgetSettings" Header="⚙️ Настройки виджета..." Click="OnOpenWidgetSettingsClick"/>
            <MenuItem x:Name="MenuDuplicateWidget" Header="📋 Скопировать виджет (Создать копию)" Click="OnDuplicateWidgetClick"/>
            <MenuItem x:Name="MenuDeleteInstance" Header="🗑 Удалить этот виджет" Click="OnDeleteInstanceClick" Foreground="#EF4444"/>
            <Separator/>
            <MenuItem x:Name="MenuGroupLayer" Header="Слой отображения">
                <MenuItem x:Name="MenuLayerDesktop" Header="На рабочем столе (под всеми окнами)" IsCheckable="True" Click="OnLayerDesktopClick"/>
                <MenuItem x:Name="MenuLayerNormal" Header="Плавающее окно" IsCheckable="True" Click="OnLayerNormalClick"/>
                <MenuItem x:Name="MenuLayerTop" Header="Поверх всех окон" IsCheckable="True" Click="OnLayerTopClick"/>
            </MenuItem>
            <MenuItem x:Name="MenuGroupTheme" Header="Тема оформления">
                <MenuItem x:Name="MenuThemeAuto" Header="✦ Как в Хабе (Авто)" IsCheckable="True" Click="OnThemeAutoClick"/>
                <MenuItem x:Name="MenuThemeDark" Header="🌙 Тёмная тема" IsCheckable="True" Click="OnThemeDarkClick"/>
                <MenuItem x:Name="MenuThemeLight" Header="☀️ Светлая тема" IsCheckable="True" Click="OnThemeLightClick"/>
            </MenuItem>
            <MenuItem x:Name="MenuLockPosition" Header="Зафиксировать позицию" IsCheckable="True" Click="OnLockPositionClick"/>
            <MenuItem x:Name="MenuClickThrough" Header="Клик насквозь (Click-through)" IsCheckable="True" Click="OnClickThroughClick"/>
            <MenuItem x:Name="MenuAutoHideDot" Header="Спрятать точку управления" IsCheckable="True" Click="OnAutoHideDotClick" Visibility="Collapsed"/>
            <MenuItem x:Name="MenuGroupResize" Header="Изменить размер">
                <MenuItem x:Name="MenuResize75" Header="75% (Компактный)" Click="OnResize75Click"/>
                <MenuItem x:Name="MenuResize100" Header="100% (Обычный)" Click="OnResize100Click"/>
                <MenuItem x:Name="MenuResize125" Header="125% (Увеличенный)" Click="OnResize125Click"/>
                <MenuItem x:Name="MenuResize150" Header="150% (Большой)" Click="OnResize150Click"/>
                <Separator/>
                <MenuItem x:Name="MenuFreeResizeToggle" Header="Тянуть за края (Свободный размер)" IsCheckable="True" Click="OnToggleFreeResizeClick"/>
            </MenuItem>
            <MenuItem x:Name="MenuGroupOpacity" Header="Прозрачность фона">
                <MenuItem x:Name="MenuOpacity100" Header="100% (Непрозрачный фон)" Click="OnOpacity100Click"/>
                <MenuItem x:Name="MenuOpacity85" Header="75% фона" Click="OnOpacity85Click"/>
                <MenuItem x:Name="MenuOpacity70" Header="50% фона" Click="OnOpacity70Click"/>
                <MenuItem x:Name="MenuOpacity50" Header="25% фона (Стекло)" Click="OnOpacity50Click"/>
            </MenuItem>
            <MenuItem x:Name="MenuMonitors" Header="Переместить на монитор..."/>
            <MenuItem x:Name="MenuGaugesConstructor" Header="🎨 Изменить формат (Конструктор)..." Visibility="Collapsed" Click="OnOpenGaugesConstructorClick"/>
            <Separator x:Name="MenuCustomSeparator" Visibility="Collapsed"/>
            <MenuItem x:Name="MenuCustomSettings" Header="Настройки виджета" Visibility="Collapsed"/>
            <Separator/>
            <MenuItem x:Name="MenuReloadWidget" Header="⟳ Перезагрузить виджет" Click="OnReloadWidgetClick"/>
            <MenuItem x:Name="MenuDevTools" Header="🛠 Открыть DevTools (F12)" Click="OnOpenDevToolsClick"/>
            <MenuItem x:Name="MenuOpenFolder" Header="Открыть папку виджета" Click="OnOpenFolderClick"/>
            <MenuItem x:Name="MenuOpenHub" Header="Открыть Хаб ChattyWidgets" Click="OnOpenHubClick"/>
            <Separator/>
            <MenuItem x:Name="MenuCloseWidget" Header="Скрыть виджет" Click="OnCloseWidgetClick" Foreground="#EF4444"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="MainRoot" Background="{x:Null}" MouseRightButtonUp="OnWindowRightButtonUp">
        <!-- Content placeholder for either Web or Native -->
        <ContentControl x:Name="WidgetContentHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

        <!-- Loading indicator -->
        <Border x:Name="LoadingIndicator" Background="#E0121622" CornerRadius="16" BorderBrush="#30FFFFFF" BorderThickness="1"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="TxtLoadingTitle" Text="✦ Загрузка виджета..." Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Anchor container and dot for click-through control and moving (always blue, neatly inside widget) -->
        <Grid x:Name="AnchorContainer" Width="36" Height="36"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Background="Transparent" Cursor="Hand"
              MouseRightButtonUp="OnAnchorDotRightClick"
              MouseLeftButtonDown="OnAnchorDotLeftDown"
              MouseEnter="OnAnchorContainerMouseEnter"
              MouseLeave="OnAnchorContainerMouseLeave">
            <Border x:Name="AnchorDot" Width="12" Height="12" Margin="0,12,12,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="#3B82F6" CornerRadius="6" Opacity="0.0"
                    ToolTip="Точка управления ChattyWidgets (ПКМ — меню, ЛКМ — переместить)">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#60A5FA" Opacity="0.9"/>
                </Border.Effect>
                <!-- Inner white dot -->
                <Ellipse Width="4" Height="4" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Resize grip handle (bottom right, visible when free resize is enabled) -->
        <Border x:Name="ResizeGripHandle" Width="24" Height="24"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="SizeNWSE"
                Visibility="Collapsed" Margin="0,0,3,3"
                MouseLeftButtonDown="OnResizeGripLeftDown"
                ToolTip="Потяните, чтобы изменить размер виджета">
            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,5,5"
                  Fill="#38BDF8"
                  Data="M 10,0 L 12,0 L 12,12 L 0,12 L 0,10 L 10,10 Z M 5,0 L 7,0 L 7,7 L 0,7 L 0,5 L 5,5 Z M 0,0 L 2,0 L 2,2 L 0,2 Z"
                  Opacity="0.8"/>
        </Border>
    </Grid>
</Window>
