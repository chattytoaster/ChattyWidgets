<Window x:Class="ChattyWidgets.UI.MissingWidgetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Импорт пресета"
        Width="600" Height="520"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- Modern ScrollViewer styling -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#40FFFFFF" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4F46E5"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DialogSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E2333"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333B52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A3146"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#F0111522"
            BorderBrush="#30FFFFFF"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.65" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Titlebar -->
                <RowDefinition Height="Auto"/> <!-- Notice banner -->
                <RowDefinition Height="*"/>    <!-- Missing widgets list -->
                <RowDefinition Height="Auto"/> <!-- Progress / Status -->
                <RowDefinition Height="Auto"/> <!-- Footer action buttons -->
            </Grid.RowDefinitions>

            <!-- Custom Titlebar -->
            <Grid Grid.Row="0" Background="#18FFFFFF" Height="46" MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock x:Name="TxtPresetIcon" Text="🎨" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDialogTitle" Text="Импорт пресета: «Пресет»" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" Width="38" Height="32" HorizontalAlignment="Right" Margin="0,0,8,0"
                        Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                        FontSize="14" Cursor="Hand" Click="OnCloseClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#30EF4444"/>
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Notice Banner -->
            <Border Grid.Row="1" Background="#1C2136" BorderBrush="#38436B" BorderThickness="1" CornerRadius="10" Margin="18,14,18,6" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📦" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtNoticeHeader" Text="Некоторые виджеты еще не установлены" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC"/>
                        <TextBlock x:Name="TxtNoticeDesc" Text="Для применения пресета выберите виджеты, которые необходимо загрузить из каталога:" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Missing Widgets List -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="18,8,18,8">
                <ItemsControl x:Name="MissingWidgetsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#161928" BorderBrush="#252A3F" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Selection Checkbox -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                              IsEnabled="{Binding CanSelect}"
                                              VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <!-- Icon badge -->
                                    <Border Grid.Column="1" Width="42" Height="42" Background="#1E2338" CornerRadius="9" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconEmoji}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                            <Border Background="#252B42" CornerRadius="5" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="#818CF8"/>
                                            </Border>
                                            <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="11" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Author row -->
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Автор: " FontSize="11" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding DisplayAuthor}" FontSize="11" Foreground="#94A3B8" FontWeight="Medium"/>
                                            <Border Visibility="{Binding VerifiedBadgeVisibility}"
                                                    Width="13" Height="13" CornerRadius="6.5"
                                                    Background="#5A58EC"
                                                    Margin="4,0,0,0" VerticalAlignment="Center">
                                                <Viewbox Width="7" Height="7" Margin="-0.5,-0.5,0.5,0.5">
                                                    <Path Data="M 1.5,4.5 L 3.5,6.5 L 7.5,2"
                                                          Stroke="#FFFFFF" StrokeThickness="1.3"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </Viewbox>
                                            </Border>
                                        </StackPanel>

                                        <!-- Description -->
                                        <TextBlock Text="{Binding DisplayDescription}" FontSize="11.5" Foreground="#94A3B8" 
                                                   Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="3" Background="{Binding StatusBg}" BorderBrush="{Binding StatusBorder}" BorderThickness="1" 
                                            CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusFg}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Progress Bar Section (Visible during install) -->
            <Border Grid.Row="3" x:Name="PanelProgress" Visibility="Collapsed" Background="#141824" BorderBrush="#2A3146" BorderThickness="0,1,0,0" Padding="18,10">
                <StackPanel>
                    <TextBlock x:Name="TxtProgressStatus" Text="Установка виджетов..." FontSize="12" Foreground="#38BDF8" Margin="0,0,0,6"/>
                    <ProgressBar x:Name="ProgressBarInstall" Height="5" Background="#1E2338" Foreground="#6366F1" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Footer Action Buttons -->
            <Border Grid.Row="4" Background="#101320" BorderBrush="#202434" BorderThickness="0,1,0,0" Padding="18,14">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSelectionCount" Text="К установке: 3 из 3" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnCancel" Content="Отмена" Style="{StaticResource DialogSecondaryBtn}" Margin="0,0,8,0" Click="OnCancelClick"/>
                        <Button x:Name="BtnApplyInstalledOnly" Content="Применить без них" Style="{StaticResource DialogSecondaryBtn}" Margin="0,0,10,0" Click="OnApplyInstalledOnlyClick"/>
                        <Button x:Name="BtnInstallAndApply" Content="✨ Установить и применить" Style="{StaticResource DialogPrimaryBtn}" Click="OnInstallAndApplyClick"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
