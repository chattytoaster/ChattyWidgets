<Window x:Class="ChattyWidgets.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ChattyWidgets.UI.Controls"
        Title="ChattyWidgets Hub"
        Icon="/app.ico"
        Height="680" Width="980"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0F111A"
        Foreground="#F8FAFC"
        UseLayoutRounding="True"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragEnter="OnWindowDragEnter">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" UseAeroCaptionButtons="False" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Modern Button Style -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4F46E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E2333"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333B52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A3146"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Nav Tab RadioButton Style -->
        <Style x:Key="NavTabBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E2235"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#171A29"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Caption Button Styles -->
        <Style x:Key="CaptionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1E2335"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2E354F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainRootBorder" BorderBrush="#252A3F" BorderThickness="1" Background="#0F111A">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Top App Bar -->
                <RowDefinition Height="64"/>
                <!-- Content Area -->
                <RowDefinition Height="*"/>
                <!-- Bottom Status Bar -->
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- Top Header Navigation / Custom Title Bar -->
            <Border x:Name="TopHeaderBorder" Grid.Row="0" Background="#121522" BorderBrush="#1E2336" BorderThickness="0,0,0,1" Padding="20,0,12,0">
                <DockPanel LastChildFill="True">
                    <!-- Logo & Brand (Draggable window caption) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,28,0">
                        <Image Source="/app.png" Width="34" Height="34" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtAppTitle" Text="ChattyWidgets" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock x:Name="TxtAppSubtitle" Text="Desktop Widget Engine" FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Window Control Buttons (Far Right) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnLanguageToggle" Content="RU" Style="{StaticResource CaptionBtnStyle}" Click="OnLanguageToggleClick" ToolTip="Язык / Language (RU / EN)"/>
                        <Button x:Name="BtnThemeToggle" Content="🌙" Style="{StaticResource CaptionBtnStyle}" Click="OnThemeToggleClick" ToolTip="Тема оформления (Тёмная / Светлая)"/>
                        <Button x:Name="BtnMinimizeWindow" Content="—" Style="{StaticResource CaptionBtnStyle}" Click="OnMinimizeWindowClick" ToolTip="Свернуть"/>
                        <Button x:Name="BtnMaximizeRestore" Content="▢" Style="{StaticResource CaptionBtnStyle}" Click="OnMaximizeRestoreWindowClick" ToolTip="Развернуть"/>
                        <Button x:Name="BtnCloseWindow" Content="✕" Style="{StaticResource CloseCaptionBtnStyle}" Click="OnCloseWindowClick" ToolTip="Закрыть в трей"/>
                    </StackPanel>

                    <!-- Navigation Tabs -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton x:Name="TabMyWidgets" Content="📱 Мои виджеты" Style="{StaticResource NavTabBtn}" IsChecked="True" Checked="OnTabChanged"/>
                        <RadioButton x:Name="TabStore" Content="🛍 Магазин" Style="{StaticResource NavTabBtn}" Checked="OnTabChanged"/>
                        <RadioButton x:Name="TabWorkshop" Content="🛠 Мастерская" Style="{StaticResource NavTabBtn}" Checked="OnTabChanged"/>
                        <RadioButton x:Name="TabSettings" Content="⚙ Настройки" Style="{StaticResource NavTabBtn}" Checked="OnTabChanged"/>
                    </StackPanel>
                </DockPanel>
            </Border>

        <!-- Main Content Area -->
        <DockPanel Grid.Row="1">
            <!-- Update Notification Banner (Auto height, Collapsed by default) -->
            <Border x:Name="BannerNewUpdate" DockPanel.Dock="Top" Background="#18233C" BorderBrush="#3B82F6" BorderThickness="0,0,0,1"
                    Padding="20,10" Visibility="Collapsed">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnOtaUpdateBanner" Content="⚡ Обновить по воздуху" Style="{StaticResource PrimaryBtn}"
                                Padding="14,6" FontSize="12.5" FontWeight="Bold" Click="OnOtaUpdateClick" Margin="0,0,8,0"/>
                        <Button x:Name="BtnRestartBanner" Content="🔄 Перезапустить и применить" Style="{StaticResource PrimaryBtn}"
                                Background="#10B981" BorderBrush="#059669" Padding="14,6" FontSize="12.5" FontWeight="Bold" Click="OnRestartApplyUpdateClick" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <Button x:Name="BtnDownloadUpdate" Content="💾 Скачать .exe" Style="{StaticResource SecondaryBtn}"
                                Padding="12,6" FontSize="12" Click="OnDownloadUpdateClick" Margin="0,0,10,0"/>
                        <Button x:Name="BtnDismissUpdate" Content="✕" Width="28" Height="28" Background="#20FFFFFF"
                                Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" Click="OnDismissUpdateClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✨" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtUpdateNotice" Text="Доступна новая версия ChattyWidgets!"
                                       FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            <Border Background="#2563EB" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtUpdateTag" Text="v1.0.2"
                                           FontSize="11.5" Foreground="#FFFFFF" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <!-- Inline Progress for OTA -->
                        <ProgressBar x:Name="ProgressOtaBanner" Height="4" Margin="26,6,20,0" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtOtaStatusBanner" Text="" Foreground="#94A3B8" FontSize="11" Margin="26,2,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Margin="24">
            
            <!-- TAB 1: MY WIDGETS -->
            <Grid x:Name="ViewMyWidgets" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="TxtInstalledTitle" Text="Установленные виджеты" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtActiveCount" Text="0 активно" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button x:Name="BtnRefreshInstalled" Content="Обновить" Style="{StaticResource SecondaryBtn}" Click="OnRefreshInstalledClick"/>
                    </StackPanel>
                </DockPanel>

                <!-- Desktop Layout Presets Toolbar -->
                <Border Grid.Row="1" Background="#161928" BorderBrush="#252A3F" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,16">
                    <DockPanel LastChildFill="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,14,0">
                            <TextBlock x:Name="TxtPresetsLabel" Text="🎨 Пресеты стола:" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button x:Name="BtnImportPreset" Content="📥 Импорт .chwp" Style="{StaticResource SecondaryBtn}" Click="OnImportPresetFileClick" Margin="0,0,8,0"
                                    ToolTip="Загрузить пресет рабочего стола из файла .chwp"/>
                            <Button x:Name="BtnSavePreset" Content="+ Сохранить текущий вид" Style="{StaticResource PrimaryBtn}" Click="OnSaveCurrentPresetClick"
                                    ToolTip="Сохранить текущее расположение виджетов на экране как пресет"/>
                        </StackPanel>
                        <WrapPanel x:Name="PresetChipsPanel" VerticalAlignment="Center" Orientation="Horizontal"/>
                    </DockPanel>
                </Border>

                <!-- Cards list -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- Empty State when no widgets are installed -->
                        <Border x:Name="InstalledEmptyState" Visibility="Collapsed" Background="#161928" BorderBrush="#252A3F" BorderThickness="1" CornerRadius="16" Padding="32,48" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="64" Height="64" Background="#1E2338" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <Image Source="/app.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtEmptyInstalledTitle" Text="У вас пока нет установленных виджетов" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtEmptyInstalledDesc" Text="Откройте каталог виджетов, чтобы выбрать и установить часы, монитор ресурсов, плеер, заметки и другие виджеты." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" Margin="0,0,0,20"/>
                                <Button x:Name="BtnGoToStore" Content="🛍️ Открыть Каталог Виджетов" Style="{StaticResource PrimaryBtn}" Padding="20,10" HorizontalAlignment="Center" Click="OnGoToStoreClick"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="InstalledWidgetsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#161928" BorderBrush="#252A3F" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="Auto"/>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Type icon badge -->
                                        <Border Grid.Column="0" Width="44" Height="44" Background="#1E2338" CornerRadius="10" Margin="0,0,16,0">
                                            <Image Source="/app.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                         <!-- Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:MarqueeText Text="{Binding Manifest.DisplayName}" MaxWidth="260" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <Border Background="#1E293B" CornerRadius="6" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding ActiveCopiesVisibility}">
                                                    <TextBlock Text="{Binding ActiveCopiesText}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </Border>
                                                <Border Background="#252B42" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Manifest.Type}" FontSize="10" FontWeight="Bold" Foreground="#818CF8"/>
                                                </Border>
                                                <Border Background="{Binding BadgeBg}" CornerRadius="6" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}">
                                                    <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeFg}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Manifest.Version, StringFormat='v{0}'}" FontSize="11" Foreground="#64748B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AuthorPrefix}" FontSize="11" Foreground="#64748B" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding DisplayAuthor}" FontSize="11" Foreground="#94A3B8" FontWeight="Medium"/>
                                                <Border Visibility="{Binding VerifiedBadgeVisibility}"
                                                        Width="14" Height="14" CornerRadius="7"
                                                        Background="#5A58EC"
                                                        Margin="5,0,0,0" VerticalAlignment="Center"
                                                        ToolTip="Официальный разработчик ChattyWidgets / Verified Official Author">
                                                    <Viewbox Width="8" Height="8" Margin="-0.5,-0.5,0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Data="M 1.5,4.5 L 3.5,6.5 L 7.5,2"
                                                              Stroke="#FFFFFF"
                                                              StrokeThickness="1.3"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>
                                                    </Viewbox>
                                                </Border>
                                            </StackPanel>

                                            <!-- Description -->
                                            <TextBlock Text="{Binding DisplayDescription}" FontSize="12" Foreground="#94A3B8" 
                                                       Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding DescriptionVisibility}"/>

                                            <!-- Update available badge -->
                                            <Border Background="#163326" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,6,0,0"
                                                    Visibility="{Binding UpdateBadgeVisibility}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding UpdateBadgeText}" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button Content="{Binding UpdateButtonText}" Style="{StaticResource SecondaryBtn}" Padding="8,2" Margin="10,0,0,0" Tag="{Binding Manifest.Id}" Click="OnUpdateWidgetClick" Foreground="#34D399"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#350A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,6,0,0"
                                                    Visibility="{Binding WarningVisibility}">
                                                <TextBlock Text="{Binding WarningMessage}" FontSize="11" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="⚙️" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Tag="{Binding Manifest.Id}" Click="OnConfigureWidgetFromHubClick" ToolTip="{Binding ConfigureTooltip}"/>
                                            <Button Content="{Binding AddInstanceButtonText}" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Tag="{Binding Manifest.Id}" Click="OnDuplicateFromHubClick" ToolTip="{Binding AddInstanceTooltip}" FontWeight="Bold" FontSize="14" Padding="10,4"/>
                                            <Button Content="{Binding DeleteButtonText}" Style="{StaticResource SecondaryBtn}" Margin="0,0,12,0" Foreground="#EF4444" Tag="{Binding Manifest.Id}" Click="OnDeleteWidgetClick" ToolTip="{Binding DeleteTooltip}" FontSize="13" Padding="8,4"/>
                                            <Button Content="{Binding ToggleButtonText}" Style="{StaticResource PrimaryBtn}" Background="{Binding ToggleButtonBg}" Tag="{Binding Manifest.Id}" Click="OnToggleWidgetClick"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- TAB 2: STORE -->
            <Grid x:Name="ViewStore" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock x:Name="TxtStoreTitle" Text="Магазин Виджетов" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <Button x:Name="BtnRefreshStore" Content="Проверить обновления" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Right" Click="OnRefreshStoreClick"/>
                </DockPanel>

                <!-- Drag & drop box hint -->
                <Border Grid.Row="1" Background="#141926" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,16">
                    <DockPanel>
                        <TextBlock x:Name="TxtStoreHintTitle" Text="📦 Подсказка: " FontWeight="Bold" Foreground="#38BDF8" DockPanel.Dock="Left"/>
                        <controls:MarqueeText x:Name="TxtStoreHintDesc" Text="Перетащите любой файл .chw прямо в это окно для мгновенной установки виджета." Foreground="#94A3B8"/>
                    </DockPanel>
                </Border>

                <!-- Store Items Grid -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="StoreItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#161928" BorderBrush="#252A3F" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="44" Height="44" Background="#1E2338" CornerRadius="10" Margin="0,0,16,0">
                                            <Image Source="/app.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:MarqueeText Text="{Binding DisplayName}" MaxWidth="260" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <Border Background="#252B42" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </Border>
                                                <Border Background="{Binding BadgeBg}" CornerRadius="6" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}">
                                                    <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeFg}"/>
                                                </Border>
                                                <TextBlock Text="{Binding DisplayVersion}" FontSize="11" Foreground="#64748B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Size}" FontSize="11" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                <Border Background="#163326" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding UpdateBadgeVisibility}">
                                                    <TextBlock Text="{Binding UpdateBadgeText}" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AuthorPrefix}" FontSize="11" Foreground="#64748B" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding DisplayAuthor}" FontSize="11" Foreground="#94A3B8" FontWeight="Medium"/>
                                                <Border Visibility="{Binding VerifiedBadgeVisibility}"
                                                        Width="14" Height="14" CornerRadius="7"
                                                        Background="#5A58EC"
                                                        Margin="5,0,0,0" VerticalAlignment="Center"
                                                        ToolTip="Официальный разработчик ChattyWidgets / Verified Official Author">
                                                    <Viewbox Width="8" Height="8" Margin="-0.5,-0.5,0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Data="M 1.5,4.5 L 3.5,6.5 L 7.5,2"
                                                              Stroke="#FFFFFF"
                                                              StrokeThickness="1.3"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>
                                                    </Viewbox>
                                                </Border>
                                            </StackPanel>

                                            <!-- Description -->
                                            <TextBlock Text="{Binding DisplayDescription}" FontSize="12" Foreground="#94A3B8" 
                                                       Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding DescriptionVisibility}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="{Binding ActionButtonText}" Style="{StaticResource PrimaryBtn}" 
                                                    Background="{Binding ActionButtonBg}" IsEnabled="{Binding CanInstall}"
                                                    Tag="{Binding}" Click="OnInstallStoreItemClick"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- TAB 3: WORKSHOP (DEVTOOLS) -->
            <Grid x:Name="ViewWorkshop" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtWorkshopTitle" Text="Мастерская Разработчика (.chw)" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,16"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Card: AI Agent Skill (/chw) -->
                        <Border Background="#161928" BorderBrush="#252A3F" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header + Status Badge -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="🤖" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtSkillCardTitle" Text="Скилл для ИИ-Агентов (/chw)" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Status Badge -->
                                    <Border x:Name="BadgeSkillStatus" DockPanel.Dock="Right" Background="#064E3B" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSkillStatusBadge" Text="✓ Скилл установлен" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                    </Border>
                                </DockPanel>

                                <!-- Description & Path -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                                    <TextBlock x:Name="TxtSkillDesc" Text="Позволяет AI-ассистентам (Antigravity, Claude Code, Cursor, Codex) автономно генерировать новые виджеты по команде /chw: верстать стекловидный XAML UI, писать ViewModel, настраивать manifest.json, упаковывать в .chw, тестировать на рабочем столе и публиковать в каталог."
                                               FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,8"/>

                                    <Border Background="#10121C" BorderBrush="#202434" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                        <DockPanel>
                                            <TextBlock x:Name="TxtSkillPathLabel" Text="📁 Расположение:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtSkillPath" Text="~/.agents/skills/chw" FontSize="11" Foreground="#38BDF8" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Actions & Command Hint -->
                                <DockPanel Grid.Row="2">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <Button x:Name="BtnInstallAgentSkill" Content="⚡ Установить скилл /chw" Style="{StaticResource PrimaryBtn}" Click="OnInstallAgentSkillClick" Margin="0,0,10,0"/>
                                        <Button x:Name="BtnOpenSkillFolder" Content="📂 Открыть папку" Style="{StaticResource SecondaryBtn}" Click="OnOpenSkillFolderClick"/>
                                    </StackPanel>

                                    <Border DockPanel.Dock="Right" Background="#1E2338" CornerRadius="8" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtSkillCommandLabel" Text="Команда в чате: " FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                            <TextBlock Text="/chw &lt;описание виджета&gt;" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                            </Grid>
                        </Border>

                        <!-- Form: Create New Widget -->
                        <Border Background="#161928" BorderBrush="#252A3F" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtCreateTemplateTitle" Text="Создать новый виджет из шаблона" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TxtWidgetIdLabel" Text="ID виджета (латиница без пробелов):" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="InputNewWidgetId" Text="com.myname.cool-widget" Background="#10121C" Foreground="#F8FAFC" BorderBrush="#333B52" Padding="8" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="TxtWidgetNameLabel" Text="Название виджета:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="InputNewWidgetName" Text="Мой Новый Виджет" Background="#10121C" Foreground="#F8FAFC" BorderBrush="#333B52" Padding="8" FontSize="13"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TxtAuthorLabel" Text="Имя автора:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="InputNewWidgetAuthor" Text="Developer" Background="#10121C" Foreground="#F8FAFC" BorderBrush="#333B52" Padding="8" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="TxtRuntimeTypeLabel" Text="Тип рантайма:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="ComboNewWidgetType" SelectedIndex="0">
                                            <ComboBoxItem Content="Web (HTML/CSS/JavaScript + Edge WebView2)"/>
                                            <ComboBoxItem Content="Native (Чистый XAML / .NET 8 с 0% CPU)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="TxtDescLabel" Text="Краткое описание:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="InputNewWidgetDesc" Text="Полезный виджет для рабочего стола Windows" Background="#10121C" Foreground="#F8FAFC" BorderBrush="#333B52" Padding="8" FontSize="13" Margin="0,0,0,16"/>

                                <Button x:Name="BtnCreateWidgetTemplate" Content="✨ Создать каркас проекта виджета" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left" Click="OnCreateWidgetTemplateClick"/>
                            </StackPanel>
                        </Border>

                        <!-- Form: Pack to .chw -->
                        <Border Background="#161928" BorderBrush="#252A3F" BorderThickness="1" CornerRadius="14" Padding="20">
                            <StackPanel>
                                <TextBlock x:Name="TxtPackTitle" Text="Экспорт папки в пакет .chw (Сборщик)" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,12"/>
                                <TextBlock x:Name="TxtPackDesc" Text="Выберите папку с manifest.json и ресурсами виджета для упаковки в распространяемый файл .chw:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,8"/>

                                <DockPanel Margin="0,0,0,12">
                                    <Button x:Name="BtnBrowseFolderToPack" Content="Обзор папки..." Style="{StaticResource SecondaryBtn}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnBrowseFolderToPackClick"/>
                                    <TextBox x:Name="InputPackFolderPath" Background="#10121C" Foreground="#F8FAFC" BorderBrush="#333B52" Padding="8" FontSize="13"/>
                                </DockPanel>

                                <Button x:Name="BtnExportPackage" Content="📦 Собрать пакет .chw" Style="{StaticResource PrimaryBtn}" Background="#10B981" HorizontalAlignment="Left" Click="OnExportChwPackageClick"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- TAB 4: SETTINGS -->
            <Grid x:Name="ViewSettings" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtSettingsTitle" Text="Настройки движка" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,16"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#161928" BorderBrush="#252A3F" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox x:Name="CheckAutostart" Content="Запускать ChattyWidgets автоматически при старте Windows" FontSize="14" Foreground="#F8FAFC" Checked="OnAutostartChanged" Unchecked="OnAutostartChanged" Margin="0,0,0,14"/>
                                <CheckBox x:Name="CheckSnapGrid" Content="Включить прилипание виджетов к краям экрана и сетке" FontSize="14" Foreground="#F8FAFC" Checked="OnSnapGridChanged" Unchecked="OnSnapGridChanged" Margin="0,0,0,14"/>
                                <CheckBox x:Name="CheckHotkeys" Content="Включить глобальные хоткеи (Win+Alt+W: скрыть/показать, Win+Alt+P: «Быстрый взгляд»)" FontSize="14" Foreground="#F8FAFC" Checked="OnHotkeysChanged" Unchecked="OnHotkeysChanged" Margin="0,0,0,14"/>
                                <CheckBox x:Name="CheckAcrylic" Content="Включить эффект размытия Acrylic / Mica для прозрачных виджетов" FontSize="14" Foreground="#F8FAFC" Checked="OnAcrylicChanged" Unchecked="OnAcrylicChanged" Margin="0,0,0,14"/>
                                <CheckBox x:Name="CheckHotReload" Content="Включить Hot Reload (авто-перезагрузка при изменении кода виджета)" FontSize="14" Foreground="#F8FAFC" Checked="OnHotReloadChanged" Unchecked="OnHotReloadChanged" Margin="0,0,0,14"/>
                                <CheckBox x:Name="CheckDevMode" Content="Режим разработчика (F12 DevTools и расширенная консоль)" FontSize="14" Foreground="#F8FAFC" Checked="OnDevModeChanged" Unchecked="OnDevModeChanged" Margin="0,0,0,14"/>
                                <CheckBox x:Name="CheckAlwaysResizable" Content="Виджеты расширяемые все время" FontSize="14" Foreground="#F8FAFC" Checked="OnAlwaysResizableChanged" Unchecked="OnAlwaysResizableChanged" Margin="0,0,0,14"/>

                                <Separator Background="#252A3F" Margin="0,4,0,14"/>

                                <!-- Theme Selection -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtHubThemeLabel" Text="Тема оформления (Хаб и виджеты):" FontSize="13" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TxtHubThemeHint" Text="При светлой теме иконки темные, при темной — светлые" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ComboHubTheme" Grid.Column="1" Width="260" Height="32" SelectionChanged="OnComboHubThemeChanged"
                                              Background="#1E2333" Foreground="#F8FAFC" BorderBrush="#333B52">
                                        <ComboBoxItem Content="🌙 Тёмная тема (Dark)" Tag="dark"/>
                                        <ComboBoxItem Content="☀️ Светлая тема (Light)" Tag="light"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Language Selection -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtHubLanguageLabel" Text="Язык интерфейса (Хаб и виджеты):" FontSize="13" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TxtHubLanguageHint" Text="Русский и английский с мгновенным переключением" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ComboHubLanguage" Grid.Column="1" Width="260" Height="32" SelectionChanged="OnComboHubLanguageChanged"
                                              Background="#1E2333" Foreground="#F8FAFC" BorderBrush="#333B52">
                                        <ComboBoxItem Content="RU Русский (Russian)" Tag="ru"/>
                                        <ComboBoxItem Content="EN English (Английский)" Tag="en"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Grid Size Slider -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtSnapGridLabel" Grid.Column="0" Text="Шаг сетки прилипания виджетов:" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="SliderGridSize" Width="260" Minimum="5" Maximum="40" Value="10" SmallChange="1" LargeChange="5"
                                                ValueChanged="OnGridSizeSliderChanged" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Border Background="#252A3F" CornerRadius="6" Padding="8,3" MinWidth="54" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtGridSizeVal" Text="10 px" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" TextAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Default Opacity Slider -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtDefaultOpacityLabel" Grid.Column="0" Text="Прозрачность фона виджетов по умолчанию:" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="SliderDefaultOpacity" Width="260" Minimum="25" Maximum="100" Value="100" SmallChange="5" LargeChange="15"
                                                ValueChanged="OnDefaultOpacitySliderChanged" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Border Background="#252A3F" CornerRadius="6" Padding="8,3" MinWidth="54" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtOpacityVal" Text="100%" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" TextAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button x:Name="BtnImportChw" Content="➕ Импортировать виджет (.chw)" Style="{StaticResource PrimaryBtn}" Margin="0,0,12,0" Click="OnImportChwClick"/>
                                    <Button x:Name="BtnOpenAppData" Content="Открыть папку данных виджетов (%LocalAppData%)" Style="{StaticResource SecondaryBtn}" Click="OnOpenAppDataClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#161928" BorderBrush="#252A3F" BorderThickness="1" CornerRadius="14" Padding="20">
                            <StackPanel>
                                <TextBlock x:Name="TxtAboutTitle" Text="О движке ChattyWidgets" FontSize="15" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock x:Name="TxtAboutVersion" Text="Версия: 1.0.2 (.NET 8.0 Windows x64)" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnCheckUpdates" Content="🔄 Проверить обновления" Style="{StaticResource SecondaryBtn}" Padding="10,4" Margin="14,0,0,0" FontSize="11" Click="OnCheckUpdatesClick"/>
                                    <Button x:Name="BtnDownloadUpdateSettings" Content="⚡ Обновить по воздуху" Style="{StaticResource PrimaryBtn}" Padding="12,4" Margin="10,0,0,0" FontSize="11.5" FontWeight="Bold" Visibility="Collapsed" Click="OnOtaUpdateClick"/>
                                </StackPanel>

                                <!-- Dedicated prominent update card right in Settings -->
                                <Border x:Name="PanelUpdateFoundSettings" Background="#172554" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="10" Padding="16,12" Margin="0,8,0,10" Visibility="Collapsed">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <Button x:Name="BtnOtaUpdateSettingsCard" Content="⚡ Обновить по воздуху" Style="{StaticResource PrimaryBtn}" Padding="14,7" FontSize="12.5" FontWeight="Bold" Click="OnOtaUpdateClick" Margin="0,0,8,0"/>
                                                <Button x:Name="BtnRestartSettingsCard" Content="🔄 Перезапустить и применить" Style="{StaticResource PrimaryBtn}" Background="#10B981" BorderBrush="#059669" Padding="14,7" FontSize="12.5" FontWeight="Bold" Click="OnRestartApplyUpdateClick" Margin="0,0,8,0" Visibility="Collapsed"/>
                                                <Button x:Name="BtnDownloadUpdateCard" Content="💾 Скачать .exe" Style="{StaticResource SecondaryBtn}" Padding="12,7" FontSize="12" Click="OnDownloadUpdateClick" Margin="0,0,8,0"/>
                                                <Button x:Name="BtnViewReleaseNotes" Content="📋 Что нового?" Style="{StaticResource SecondaryBtn}" Padding="10,7" FontSize="11.5" Click="OnViewReleaseNotesClick"/>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="🎉" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtUpdateFoundTitle" Text="Доступна новая версия!" Foreground="#60A5FA" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtUpdateFoundSub" Text="Обновление по воздуху скачивается и применяется автоматически без запуска стороннего сетапа." Foreground="#94A3B8" FontSize="11.5"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- OTA Progress in Settings Card -->
                                        <StackPanel x:Name="PanelOtaProgressSettings" Margin="0,10,0,0" Visibility="Collapsed">
                                            <ProgressBar x:Name="ProgressOtaSettings" Height="6" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0"/>
                                            <TextBlock x:Name="TxtOtaStatusSettings" Text="Загрузка обновления..." Foreground="#38BDF8" FontSize="11.5" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="TxtUpdateStatus" Text="" Foreground="#34D399" FontSize="11.5" Margin="0,2,0,6" Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtAboutDesc" Text="Движок оптимизирован для фоновой работы: нативные виджеты не нагружают процессор (0% CPU) и занимают минимум памяти." Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>

                                <!-- Official Links & Community Buttons -->
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="BtnAboutGithub" Content="🐙 GitHub" Style="{StaticResource SecondaryBtn}" Padding="12,7" Margin="0,0,8,8" Click="OnAboutGithubClick" ToolTip="https://github.com/chattytoaster/ChattyWidgets"/>
                                    <Button x:Name="BtnAboutSite" Content="🌐 chattyapps.dev" Style="{StaticResource SecondaryBtn}" Padding="12,7" Margin="0,0,8,8" Click="OnAboutSiteClick" ToolTip="https://chattyapps.dev"/>
                                    <Button x:Name="BtnAboutTelegramChannel" Content="📢 @chattyappsdev" Style="{StaticResource SecondaryBtn}" Padding="12,7" Margin="0,0,8,8" Click="OnAboutTelegramChannelClick" ToolTip="https://t.me/chattyappsdev"/>
                                    <Button x:Name="BtnAboutTelegramBot" Content="🤖 @chattyappsbot" Style="{StaticResource SecondaryBtn}" Padding="12,7" Margin="0,0,8,8" Click="OnAboutTelegramBotClick" ToolTip="https://t.me/chattyappsbot"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>
        </DockPanel>

        <!-- Bottom Status Bar -->
        <Border x:Name="BottomStatusBar" Grid.Row="2" Background="#0C0E15" BorderBrush="#1A1E2C" BorderThickness="0,1,0,0" Padding="24,0">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="TxtStatus" Text="Готово" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtEngineVersion" Text="ChattyWidgets Engine v1.0.0" FontSize="11" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
    </Border>
</Window>
