<Window x:Class="ChattyWidgets.UI.WidgetSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки виджета"
        Width="460" Height="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Border Background="#F0111522"
            BorderBrush="#30FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Titlebar -->
                <RowDefinition Height="*"/>    <!-- Settings Body -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Custom Titlebar -->
            <Grid Grid.Row="0" Background="#18FFFFFF" Height="42" MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="⚙️ " FontSize="14"/>
                    <TextBlock x:Name="TxtWindowTitle" Text="Настройки виджета" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC"/>
                </StackPanel>
                <Button Content="✕" Width="36" Height="30" HorizontalAlignment="Right" Margin="0,0,6,0"
                        Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                        FontSize="14" Cursor="Hand" Click="OnCloseClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#30EF4444"/>
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Scrollable Settings Container -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="18,14,18,14">
                <StackPanel x:Name="SettingsPanel">
                    <!-- Dynamic settings controls injected based on widget type -->
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0" Padding="16,12">
                <DockPanel>
                    <TextBlock x:Name="TxtStatus" Text="Изменения применяются мгновенно" FontSize="11" Foreground="#94A3B8"
                               VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <Button x:Name="BtnDone" Content="Готово" Width="90" Height="32" HorizontalAlignment="Right" DockPanel.Dock="Right"
                            Background="#38BDF8" Foreground="#0F172A" FontWeight="Bold" FontSize="12"
                            BorderThickness="0" Cursor="Hand" Click="OnCloseClick">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
